# Server Port
PORT=5000

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Firebase Admin Service Account Key
# Option 1: Relative or absolute path to your downloaded serviceAccountKey.json file
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option 2: Stringified JSON of the service account
# FIREBASE_SERVICE_ACCOUNT_KEY=
